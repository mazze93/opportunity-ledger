{
  "name": "opportunity-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "wrangler deploy --dry-run",
