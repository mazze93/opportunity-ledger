// signal-desk-view: private desk at desk.mazzeleczzare.com.
// Deploy from the repo root: npx wrangler deploy -c desk/wrangler.jsonc
// Reachable ONLY through the custom domain, which Cloudflare Access gates.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "signal-desk-view",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  // No *.workers.dev URL and no preview URLs: both would sit outside Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "desk.mazzeleczzare.com", "custom_domain": true }],
  "vars": { "SIGNAL_DESK_REPO": "mazze93/signal-desk" },
  // Secrets (wrangler secret put, never committed). The Worker refuses every
  // request with 503 until the first three are set:
  //   ACCESS_TEAM_DOMAIN e.g. <team>.cloudflareaccess.com
  //   ACCESS_AUD         Application Audience (AUD) tag of the Access app
  //   ALLOWED_EMAIL      the one email allowed in
  //   SIGNAL_DESK_TOKEN  fine-grained GitHub token, signal-desk only, Contents: read
  //   LEDGER_TOKEN       same value as the ledger Worker's LEDGER_TOKEN
  // Uncomment once the opportunity-ledger Worker is deployed:
  // "services": [{ "binding": "LEDGER", "service": "opportunity-ledger" }],
  "observability": { "enabled": true }
}
